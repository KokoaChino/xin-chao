s://web-static.kurobbs.com/wiki_audio/1735750289942387099.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324178221370990592","title":"共鸣解放6","text":"熄灭，残响之音。","url":"https://web-static.kurobbs.com/wiki_audio/1735750289953146235.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324173131675361280","title":"受击1","text":"（语气词）","url":"https://web-static.kurobbs.com/wiki_audio/1735749076484937964.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324173131694366720","title":"受击2","text":"唔……找准时机。","url":"https://web-static.kurobbs.com/wiki_audio/1735749076503706396.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324173131684143104","title":"受击3","text":"再来一次。","url":"https://web-static.kurobbs.com/wiki_audio/1735749076495218127.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324173213427732480","title":"重伤1","text":"呼……","url":"https://web-static.kurobbs.com/wiki_audio/1735749096001551572.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324173213654224896","title":"重伤2","text":"保持冷静。","url":"https://web-static.kurobbs.com/wiki_audio/1735749096053766996.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324173213915308032","title":"重伤3","text":"最后的机会……","url":"https://web-static.kurobbs.com/wiki_audio/1735749096114847764.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324173071046696960","title":"力竭1","text":"还不能……结束","url":"https://web-static.kurobbs.com/wiki_audio/1735749062032220478.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324173071080644608","title":"力竭2","text":"到极限了吗……","url":"https://web-static.kurobbs.com/wiki_audio/1735749062046884729.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324173071004753920","title":"力竭3","text":"声音在消逝……","url":"https://web-static.kurobbs.com/wiki_audio/1735749062042652495.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324173110949339136","title":"声骸异能召唤","text":"希望这个有用。","url":"https://web-static.kurobbs.com/wiki_audio/1735749071571934674.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324173110913949696","title":"声骸异能变身","text":"声形合一。","url":"https://web-static.kurobbs.com/wiki_audio/1735749071556982525.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324173027841171456","title":"变奏技能","text":"速战速决。","url":"https://web-static.kurobbs.com/wiki_audio/1735749051689880229.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324173048779530240","title":"进战提醒","text":"交给我吧。","url":"https://web-static.kurobbs.com/wiki_audio/1735749056704102310.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324172975821447168","title":"滑翔","text":"跟随风的方向。","url":"https://web-static.kurobbs.com/wiki_audio/1735749039301171827.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324172975715553280","title":"钩索","text":"（语气词）","url":"https://web-static.kurobbs.com/wiki_audio/1735749039238594933.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324172976022773760","title":"感知","text":"旅途中总是充满惊喜。","url":"https://web-static.kurobbs.com/wiki_audio/1735749039363116036.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324172975669415936","title":"冲刺","text":"（语气词）","url":"https://web-static.kurobbs.com/wiki_audio/1735749039238173683.wav","language":"中文","cv":"马洋","category":"combat"},{"id":"1242115703531454464-voice-12-0-1324172975794446336","title":"纵跑","text":"（语气词）","url":"https:/